{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/product/singleProduct/:id",
      "destination": "https://malikpetshop.onrender.com/product/singleProduct/:id"
    },
    { "source": "/((?!sitemap.xml|robots.txt).*)", "destination": "/" }
  ]
}